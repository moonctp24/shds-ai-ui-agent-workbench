v>\n              </div>\n              <div style=\"color:#94a3b8;font-size:18px;line-height:1;\">›</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid #f8fafc;\">\n              <div style=\"width:40px;height:40px;border-radius:50%;background:#e2e8f0;flex-shrink:0;\"></div>\n              <div style=\"flex:1;\">\n                <div style=\"background:#cbd5e1;height:13px;width:120px;border-radius:4px;margin-bottom:6px;\"></div>\n                <div style=\"background:#e2e8f0;height:11px;width:80px;border-radius:4px;\"></div>\n              </div>\n              <div style=\"color:#94a3b8;font-size:18px;line-height:1;\">›</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid #f8fafc;\">\n              <div style=\"width:40px;height:40px;border-radius:50%;background:#e2e8f0;flex-shrink:0;\"></div>\n              <div style=\"flex:1;\">\n                <div style=\"background:#cbd5e1;height:13px;width:120px;border-radius:4px;margin-bottom:6px;\"></div>\n                <div style=\"background:#e2e8f0;height:11px;width:80px;border-radius:4px;\"></div>\n              </div>\n              <div style=\"color:#94a3b8;font-size:18px;line-height:1;\">›</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid #f8fafc;\">\n              <div style=\"width:40px;height:40px;border-radius:50%;background:#e2e8f0;flex-shrink:0;\"></div>\n              <div style=\"flex:1;\">\n                <div style=\"background:#cbd5e1;height:13px;width:120px;border-radius:4px;margin-bottom:6px;\"></div>\n                <div style=\"background:#e2e8f0;height:11px;width:80px;border-radius:4px;\"></div>\n              </div>\n              <div style=\"color:#94a3b8;font-size:18px;line-height:1;\">›</div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <!-- Section divider -->\n      <div style=\"height:8px;background:#f0f2f5;\"></div>\n      <!-- 카드 관리 메뉴 -->\n      <div data-id=\"comp-2-2-2\">\n        <div data-id=\"area-2-2-2-1\" style=\"margin:12px 16px;\">\n          <div style=\"background:#1e293b;border-radius:12px;padding:14px 24px;text-align:center;\">\n            <span style=\"font-size:14px;font-weight:600;color:white;\">카드 관리 버튼 그룹</span>\n          </div>\n          <div style=\"display:flex;gap:8px;margin-top:10px;\">\n            <div style=\"flex:1;background:#f1f5f9;border-radius:8px;padding:8px;text-align:center;font-size:12px;color:#64748b;\">\n              카드 재발급\n            </div>\n            <div style=\"flex:1;background:#f1f5f9;border-radius:8px;padding:8px;text-align:center;font-size:12px;color:#64748b;\">\n              사용 정지\n            </div>\n            <div style=\"flex:1;background:#f1f5f9;border-radius:8px;padding:8px;text-align:center;font-size:12px;color:#64748b;\">\n              해지 신청\n            </div>\n          </div>\n        </div>\n      </div>\n      <!-- Section divider -->\n      <div style=\"height:8px;background:#f0f2f5;\"></div>\n    </div>\n  </div>\n</body>\n</html>"
