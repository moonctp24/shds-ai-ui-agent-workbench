      "preview_html": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>모바일 와이어프레임</title>\n  <meta name=\"viewport\" content=\"width=390, initial-scale=1, maximum-scale=1\">\n  <script>\n  (function(){\n    function applyHighlight(id){\n      document.querySelectorAll('[data-id]').forEach(function(el){\n        el.style.outline='';\n        el.style.boxShadow='';\n        el.style.transition='';\n      });\n      if(!id)return;\n      var el=document.querySelector('[data-id=\"'+id+'\"]');\n      if(el){\n        el.style.transition='box-shadow 0.15s, outline 0.15s';\n        el.style.outline='2px solid #eab308';\n        el.style.boxShadow='inset 0 0 0 9999px rgba(253,224,71,0.22)';\n        el.scrollIntoView({behavior:'smooth',block:'nearest'});\n      }\n    }\n    window.addEventListener('message',function(e){\n      var d=e.data;\n      if(d&&d.type==='highlight')applyHighlight(d.id||null);\n    });\n  })();\n  </script>\n</head>\n<body style=\"margin:0;padding:0;background:#f0f2f5;overflow-x:hidden;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;\">\n  <div style=\"width:100%;max-width:390px;margin:0 auto;background:white;min-height:100vh;overflow-x:hidden;box-sizing:border-box;\">\n    <!-- 헤더 -->\n    <div data-id=\"comp-1\" style=\"height:52px;background:#1e293b;display:flex;align-items:center;justify-content:space-between;padding:0 16px;\">\n      <div data-id=\"area-1-1\" style=\"background:rgba(255,255,255,0.15);width:80px;height:24px;border-radius:6px;display:inline-block;display:flex;align-items:center;justify-content:center;font-size:15px;color:white;font-weight:600;letter-spacing:-0.5px;\">\n        로고 및 브랜드\n      </div>\n      <div data-id=\"area-1-2\" style=\"display:flex;gap:8px;\">\n        <div style=\"background:rgba(255,255,255,0.2);width:28px;height:28px;border-radius:50%;display:inline-block;\"></div>\n        <div style=\"background:rgba(255,255,255,0.2);width:28px;height:28px;border-radius:50%;display:inline-block;\"></div>\n      </div>\n    </div>\n    <!-- Section divider -->\n    <div style=\"height:8px;background:#f0f2f5;\"></div>\n    <!-- 바디 -->\n    <!-- 대시보드 메인 콘텐츠 -->\n    <div data-id=\"comp-2-1\">\n      <!-- 요약 정보 카드 -->\n      <div data-id=\"area-2-1-1\" style=\"background:linear-gradient(135deg,#1e293b,#334155);padding:20px 16px;\">\n        <div style=\"font-size:16px;font-weight:700;color:white;margin:0 0 4px;\">요약 정보 카드</div>\n        <div style=\"font-size:12px;color:rgba(255,255,255,0.55);margin:0 0 16px;\">대시보드 메인 콘텐츠</div>\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;\">\n          <div style=\"background:rgba(255,255,255,0.1);border-radius:10px;padding:12px;\">\n            <div style=\"background:rgba(255,255,255,0.3);height:10px;width:70%;border-radius:4px;margin-bottom:8px\"></div>\n            <div style=\"background:rgba(255,255,255,0.75);height:18px;width:50%;border-radius:4px\"></div>\n          </div>\n          <div style=\"background:rgba(255,255,255,0.1);border-radius:10px;padding:12px;\">\n            <div style=\"background:rgba(255,255,255,0.3);height:10px;width:70%;border-radius:4px;margin-bottom:8px\"></div>\n            <div style=\"background:rgba(255,255,255,0.75);height:18px;width:50%;border-radius:4px\"></div>\n          </div>\n          <div style=\"background:rgba(255,255,255,0.1);border-radius:10px;padding:12px;\">\n            <div style=\"background:rgba(255,255,255,0.3);height:10px;width:70%;border-radius:4px;margin-bottom:8px\"></div>\n            <div style=\"background:rgba(255,255,255,0.75);height:18px;width:50%;border-radius:4px\"></div>\n          </div>\n          <div style=\"background:rgba(255,255,255,0.1);border-radius:10px;padding:12px;\">\n            <div style=\"background:rgba(255,255,255,0.3);height:10px;width:70%;border-radius:4px;margin-bottom:8px\"></div>\n            <div style=\"background:rgba(255,255,255,0.75);height:18px;width:50%;border-radius:4px\"></div>\n          </div>\n        </div>\n      </div>\n      <!-- Section divider -->\n      <div style=\"height:8px;background:#f0f2f5;\"></div>\n      <!-- 카드 목록 -->\n      <div data-id=\"comp-2-1-1\">\n        <!-- 카드 요약 카드 리스트 -->\n        <div data-id=\"area-2-1-1-1\">\n          <!-- 카드 요약 카드 (1개 시연) -->\n          <div data-id=\"comp-2-1-1-1\" style=\"background:white;border-radius:14px;box-shadow:0 2px 12px rgba(0,0,0,0.08);margin:8px 16px;padding:16px;\">\n            <!-- 카드 정보 및 상태 -->\n            <div data-id=\"area-2-1-1-1-1\">\n              <!-- Header row -->\n              <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;\">\n                <div style=\"background:#e2e8f0;height:16px;width:140px;border-radius:6px;\"></div>\n                <div style=\"background:#dcfce7;color:#16a34a;font-size:11px;font-weight:600;padding:3px 10px;border-radius:99px;\">\n                  정상\n                </div>\n              </div>\n              <!-- Metrics row -->\n              <div style=\"display:flex;gap:8px;margin-bottom:12px;\">\n                <div style=\"flex:1;background:#f8fafc;border-radius:8px;padding:10px;\">\n                  <div style=\"background:#e2e8f0;height:10px;width:60%;border-radius:4px;margin-bottom:6px;\"></div>\n                  <div style=\"background:#cbd5e1;height:14px;width:80%;border-radius:4px;\"></div>\n                </div>\n                <div style=\"flex:1;background:#f8fafc;border-radius:8px;padding:10px;\">\n                  <div style=\"background:#e2e8f0;height:10px;width:60%;border-radius:4px;margin-bottom:6px;\"></div>\n                  <div style=\"background:#cbd5e1;height:14px;width:80%;border-radius:4px;\"></div>\n                </div>\n              </div>\n              <!-- Divider -->\n              <div style=\"border-top:1px solid #f1f5f9;padding-top:10px;\"></div>\n              <!-- Action row -->\n              <div style=\"display:flex;ga