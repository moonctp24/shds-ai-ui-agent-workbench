    "diagram": "flowchart LR\n  comp1[\"헤더\"]\n  area1_1(\"로고 및 브랜드\")\n  area1_2(\"내비게이션 메뉴\")\n  comp1 --> area1_1\n  comp1 --> area1_2\n\n  comp2[\"바디\"]\n\n  comp2_1[\"대시보드 메인 콘텐츠\"]\n  comp2 --> comp2_1\n\n  area2_1_1(\"요약 정보 카드\")\n  comp2_1 --> area2_1_1\n\n  comp2_1_1[\"카드 목록\"]\n  comp2_1 --> comp2_1_1\n\n  area2_1_1_1(\"카드 요약 카드 리스트\")\n  comp2_1_1 --> area2_1_1_1\n\n  comp2_1_1_1[\"카드 요약 카드\"]\n  comp2_1_1 --> comp2_1_1_1\n\n  area2_1_1_1_1(\"카드 정보 및 상태 표시\")\n  comp2_1_1_1 --> area2_1_1_1_1\n\n  comp2_2[\"카드 상세 페이지\"]\n  comp2 --> comp2_2\n\n  area2_2_1(\"카드 상세 정보 및 상태 패널\")\n  comp2_2 --> area2_2_1\n\n  comp2_2_1[\"이용 내역 테이블\"]\n  comp2_2 --> comp2_2_1\n\n  area2_2_1_1(\"거래 내역 테이블\")\n  comp2_2_1 --> area2_2_1_1\n\n  comp2_2_2[\"카드 관리 메뉴\"]\n  comp2_2 --> comp2_2_2\n\n  area2_2_2_1(\"카드 관리 버튼 그룹\")\n  comp2_2_2 --> area2_2_2_1",
    "preview_html": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>내 카드 관리 대시보드 - 모바일 와이어프레임</title>\n  <meta name=\"viewport\" content=\"width=390, initial-scale=1.0, user-scalable=no\">\n  <script>\n(function(){\n  function applyHighlight(id){\n    document.querySelectorAll('[data-id]').forEach(function(el){\n      el.style.outline='';\n      el.style.boxShadow='';\n      el.style.transition='';\n    });\n    if(!id)return;\n    var el=document.querySelector('[data-id=\"'+id+'\"]');\n    if(el){\n      el.style.transition='box-shadow 0.15s, outline 0.15s';\n      el.style.outline='2px solid #eab308';\n      el.style.boxShadow='inset 0 0 0 9999px rgba(253,224,71,0.22)';\n      el.scrollIntoView({behavior:'smooth',block:'nearest'});\n    }\n  }\n  window.addEventListener('message',function(e){\n    var d=e.data;\n    if(d&&d.type==='highlight')applyHighlight(d.id||null);\n  });\n})();\n  </script>\n</head>\n<body style=\"margin:0;padding:0;background:#f0f2f5;overflow-x:hidden;\">\n  <div style=\"width:100%;max-width:390px;margin:0 auto;background:white;min-height:100vh;overflow-x:hidden;box-sizing:border-box\">\n    \n    <!-- 헤더 -->\n    <div data-id=\"comp-1\" style=\"height:52px;background:#1e293b;display:flex;align-items:center;justify-content:space-between;padding:0 16px;\">\n      <!-- 로고 및 브랜드 -->\n      <div data-id=\"area-1-1\" style=\"background:rgba(255,255,255,0.15);width:80px;height:24px;border-radius:6px;display:inline-block;display:flex;align-items:center;justify-content:center;\">\n        <span style=\"font-size:13px;color:white;font-weight:600;letter-spacing:-1px;\">로고</span>\n      </div>\n      <!-- 내비게이션 메뉴 -->\n      <div data-id=\"area-1-2\" style=\"display:flex;gap:8px;\">\n        <div style=\"background:rgba(255,255,255,0.2);width:28px;height:28px;border-radius:50%;display:inline-block\"></div>\n        <div style=\"background:rgba(255,255,255,0.2);width:28px;height:28px;border-radius:50%;display:inline-block\"></div>\n      </div>\n    </div>\n    <!-- Section divider -->\n    <div style=\"height:8px;background:#f0f2f5;\"></div>\n    \n    <!-- 바디 -->\n    <div data-id=\"comp-2\" style=\"width:100%;\">\n    \n      <!-- 대시보드 메인 콘텐츠 -->\n      <div data-id=\"comp-2-1\" style=\"width:100%;\">\n        \n        <!-- 요약 정보 카드 -->\n        <section data-id=\"area-2-1-1\" style=\"background:linear-gradient(135deg,#1e293b,#334155);padding:20px 16px;\">\n          <div style=\"display:flex;flex-direction:column;gap:16px;\">\n            <div>\n              <h1 style=\"font-size:16px;font-weight:700;color:white;margin:0 0 4px;-webkit-font-smoothing:antialiased;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\">\n                내 카드 관리 대시보드\n              </h1>\n              <p style=\"font-size:12px;color:rgba(255,255,255,0.55);margin:0 0 16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\">\n                보유 카드 현황과 결제 예정 금액을 한눈에 확인하세요.\n              </p>\n            </div>\n            <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:10px;\">\n              <div style=\"background:rgba(255,255,255,0.10);border-radius:10px;padding:12px;\">\n                <div style=\"font-size:12px;color:rgba(59,130,246,0.8);margin-bottom:8px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\">총 이용 한도</div>\n                <div style=\"background:#cbd5e1;height:18px;width:70%;border-radius:4px\"></div>\n              </div>\n              <div style=\"background:rgba(255,255,255,0.10);border-radius:10px;padding:12px;\">\n                <div style=\"font-size:12px;color:rgba(59,130,246,0.8);margin-bottom:8px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\">총 결제 예정 금액</div>\n                <div style=\"background:#cbd5e1;height:18px;width:70%;border-radius:4px\"></div>\n              </div>\n            </div>\n          </div>\n        </section>\n        <!-- Section divider -