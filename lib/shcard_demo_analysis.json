                    "code": "      <div className=\"mt-3 grid gap-3 md:grid-cols-1\">\n        <button\n          type=\"button\"\n          className=\"flex items-center justify-between rounded-xl border border-slate-200 px-4 py-3 text-xs font-medium text-slate-800 transition hover:border-shinhancard-blue/40 hover:bg-slate-50\"\n        >\n          <span className=\"inline-flex items-center gap-2\">\n            <PauseCircle className=\"h-4 w-4 text-amber-500\" />\n            {isPaused ? \"카드 이용 재개\" : \"카드 일시정지\"}\n          </span>\n          <span className=\"text-[11px] text-slate-400\">설정 이동</span>\n        </button>\n\n        <button\n          type=\"button\"\n          className=\"flex items-center justify-between rounded-xl border border-slate-200 px-4 py-3 text-xs font-medium text-slate-800 transition hover:border-shinhancard-blue/40 hover:bg-slate-50\"\n        >\n          <span className=\"inline-flex items-center gap-2\">\n            <SlidersHorizontal className=\"h-4 w-4 text-shinhancard-blue\" />\n            한도 변경\n          </span>\n          <span className=\"text-[11px] text-slate-400\">신청 이동</span>\n        </button>\n\n        <button\n          type=\"button\"\n          className=\"flex items-center justify-between rounded-xl border border-red-100 bg-red-50/80 px-4 py-3 text-xs font-semibold text-red-600 transition hover:border-red-200 hover:bg-red-50\"\n        >\n          <span className=\"inline-flex items-center gap-2\">\n            <AlertTriangle className=\"h-4 w-4\" />\n            분실·도난 신고\n          </span>\n          <span className=\"text-[11px] text-red-400\">신고 바로가기</span>\n        </button>\n      </div>",
