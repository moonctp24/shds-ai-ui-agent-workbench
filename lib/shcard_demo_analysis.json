    "diagram": "flowchart LR\n  comp1[\"헤더\"]\n  area1_1(\"로고 및 브랜드\")\n  area1_2(\"내비게이션 메뉴\")\n  comp1 --> area1_1\n  comp1 --> area1_2\n\n  comp2[\"바디\"]\n\n  comp2_1[\"대시보드 메인 콘텐츠\"]\n  comp2 --> comp2_1\n  area2_1_1(\"이용 현황 배너\")\n  comp2_1 --> area2_1_1\n\n  comp2_1_1[\"카드 목록\"]\n  comp2_1 --> comp2_1_1\n  area2_1_1_1(\"카드 요약 카드 리스트\")\n  comp2_1_1 --> area2_1_1_1\n\n  comp2_1_1_1[\"카드 요약 카드\"]\n  comp2_1_1 --> comp2_1_1_1\n  area2_1_1_1_1(\"카드 정보 및 상태 표시\")\n  comp2_1_1_1 --> area2_1_1_1_1\n\n  comp2_2[\"카드 상세 페이지\"]\n  comp2 --> comp2_2\n  area2_2_1(\"카드 상세 정보 및 상태 패널\")\n  comp2_2 --> area2_2_1\n\n  comp2_2_1[\"이용 내역 테이블\"]\n  comp2_2 --> comp2_2_1\n  area2_2_1_1(\"거래 내역 테이블\")\n  comp2_2_1 --> area2_2_1_1\n\n  comp2_2_2[\"카드 관리 메뉴\"]\n  comp2_2 --> comp2_2_2\n  area2_2_2_1(\"카드 관리 버튼 그룹\")\n  comp2_2_2 --> area2_2_2_1",
    "preview_html": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=390, initial-scale=1.0, user-scalable=no\">\n  <title>신한카드 내 카드 관리</title>\n  <style>\n    *{box-sizing:border-box;margin:0;padding:0;}\n    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#f1f5f9;font-size:12px;color:#0f172a;}\n    table{border-collapse:collapse;width:100%;}\n    th,td{padding:0;}\n    button{cursor:pointer;font-family:inherit;}\n    [data-id]{position:relative;}\n  </style>\n  <script>\n(function(){\n  var currentOverlay = null;\n  var currentEl = null;\n\n  function clearHighlight(){\n    if(currentOverlay && currentOverlay.parentNode){\n      currentOverlay.parentNode.removeChild(currentOverlay);\n    }\n    if(currentEl){\n      currentEl.style.outline = '';\n    }\n    currentOverlay = null;\n    currentEl = null;\n  }\n\n  function highlight(id){\n    clearHighlight();\n    if(!id) return;\n    var el = document.querySelector('[data-id=\"'+id+'\"]');\n    if(!el) return;\n\n    /* 외곽선 */\n    el.style.outline = '2.5px solid #eab308';\n\n    /* 반투명 노란 오버레이 */\n    var ov = document.createElement('div');\n    ov.style.cssText = [\n      'position:absolute',\n      'inset:0',\n      'background:rgba(253,224,71,0.32)',\n      'pointer-events:none',\n      'z-index:9999',\n      'border-radius:inherit'\n    ].join(';');\n    el.appendChild(ov);\n\n    currentOverlay = ov;\n    currentEl = el;\n    el.scrollIntoView({behavior:'smooth', block:'nearest'});\n  }\n\n  window.addEventListener('message', function(e){\n    var d = e.data;\n    if(d && d.type === 'highlight') highlight(d.id || null);\n  });\n})();\n  </script>\n</head>\n<body>\n<div style=\"width:100%;max-width:390px;margin:0 auto;background:white;min-height:100vh;\">\n\n  <!-- PAGE 1 label -->\n  <div style=\"font-size:9px;font-weight:700;letter-spacing:1.2px;color:#94a3b8;padding:5px 14px;background:#f8fafc;border-botto